# MySQL из XAMPP — та же база «sbor», что видна в phpMyAdmin
DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=sbor;charset=utf8mb4"
DB_USER="root"
DB_PASSWORD=""
API_TOKEN="change-me"
# Связь с сайтом: адрес и ключ со страницы «Копии» (виден администратору)
SITE_URL="https://meetmagic-central.lovable.app"
SITE_SYNC_TOKEN=""
# Как часто обновлять базу из сайта при запросах к API (секунды, 0 — выключить)
SYNC_EVERY=60
